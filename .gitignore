# env files — use .env.example as template
.env
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sandbox / internal artifacts
.zscripts/
tool-results/
agent-ctx/
upload/
tests/
examples/
mini-services/

# sandbox skills tooling
skills/

# local QA artifacts (screenshots from automated browser testing)
download/

# sandbox gateway config (environment-specific, not part of the app)
Caddyfile
